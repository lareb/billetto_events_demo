<% content_for :title, "Events" %>

<h1>Upcoming Events</h1>

<% if @events.empty? %>
  <p>No events yet. Run <code>bin/rails events:ingest</code> to fetch them from Billetto.</p>
<% end %>

<ul class="events" translate="no">
  <%= turbo_frame_tag "events_page_#{@page}" do %>
    <%= render "page" %>
  <% end %>
</ul>
